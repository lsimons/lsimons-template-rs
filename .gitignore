# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Python bytecode from scripts/init.py. This is a Rust repo, but it
# ships a Python helper, and anything that imports it rather than
# running it as a script leaves bytecode behind.
__pycache__/
*.py[cod]

# Coverage
/coverage/
*.profraw
*.profdata
tarpaulin-report.html
cobertura.xml
lcov.info

# Environment
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
rls/

# Operating systems
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# mise local overrides (the committed .mise.toml is the shared config)
.mise.local.toml
mise.local.toml
.mise/

# Claude
# `.claude/` itself is tracked on purpose — settings.json is shared
# config. Only per-user state and scratch worktrees are ignored.
.claude/settings.local.json
.claude/worktrees
